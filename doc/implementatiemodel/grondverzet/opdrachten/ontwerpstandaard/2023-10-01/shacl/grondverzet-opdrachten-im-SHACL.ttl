<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#OpdrachtTypeShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass skos:Concept .

<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#PeriodeShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    shacl:class <http://www.w3.org/2006/time#Instant>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "tot"@nl;
    shacl:path <http://www.w3.org/2006/time#hasEnd>
  ], [
    shacl:class <http://www.w3.org/2006/time#Instant>;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "van"@nl;
    shacl:path <http://www.w3.org/2006/time#hasBeginning>
  ];
  shacl:targetClass <http://www.w3.org/2006/time#ProperInterval> .

<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#TemporeleEntiteitShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass <http://www.w3.org/2006/time#TemporalEntity> .
