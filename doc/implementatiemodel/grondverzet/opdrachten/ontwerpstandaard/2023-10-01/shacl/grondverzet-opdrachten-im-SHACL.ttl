<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#AgentShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass dc:Agent .

<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#AnyShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass rdfs:Resource .

<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#IdentificatorShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    shacl:description "String gebruikt om het object uniek te identificeren."@nl;
    shacl:maxCount 1;
    shacl:name "identificator"@nl;
    shacl:path skos:notation
  ], [
    shacl:class dc:Agent;
    shacl:description "Link naar de agent die de identificator heeft uitgegeven."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend door"@nl;
    shacl:path dc:creator
  ], [
    shacl:datatype xsd:string;
    shacl:description "Naam vd agent die de identificator heeft toegekend."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend door (String)"@nl;
    shacl:path <http://www.w3.org/ns/adms#schemaAgency>
  ], [
    shacl:datatype xsd:dateTime;
    shacl:description "Tijdstip waarop de identificator werd uitgegeven."@nl;
    shacl:maxCount 1;
    shacl:name "toegekend op"@nl;
    shacl:path dc:issued
  ];
  shacl:targetClass <http://www.w3.org/ns/adms#Identifier> .

<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#LocatieShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:targetClass prov:Location .

<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#MomentShape> a shacl:NodeShape;
  shacl:closed false;
  shacl:property [
    shacl:datatype xsd:dateTime;
    shacl:maxCount 1;
    shacl:minCount 1;
    shacl:name "inXSDDateTime"@nl;
    shacl:path <http://www.w3.org/2006/time#inXSDDateTime>
  ];
  shacl:targetClass <http://www.w3.org/2006/time#Instant> .

<https://implementatie.data.vlaanderen.be//doc/implementatiemodel/grondverzet/opdrachten/ontwerpstandaard/2023-10-01#OpdrachtShape> a shacl:NodeShape;
