{
  "@context": {
    "Agent": "http://purl.org/dc/terms/Agent",
    "Any": "http://www.w3.org/2000/01/rdf-schema#Resource",
    "Identificator": {
      "@context": {
        "identificator": {
          "@id": "http://www.w3.org/2004/02/skos/core#notation"
        },
        "toegekendDoor": {
          "@id": "http://purl.org/dc/terms/creator",
          "@type": "@id"
        },
        "toegekendDoor (string)": {
          "@id": "http://www.w3.org/ns/adms#schemaAgency",
          "@type": "http://www.w3.org/2001/XMLSchema#string"
        },
        "toegekendOp": {
          "@id": "http://purl.org/dc/terms/issued",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        }
      },
      "@id": "http://www.w3.org/ns/adms#Identifier"
    },
    "Locatie": "http://www.w3.org/ns/prov#Location",
    "Moment": {
      "@context": {
        "inXsdDateTime": {
          "@id": "http://www.w3.org/2006/time#inXSDDateTime",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        }
      },
      "@id": "http://www.w3.org/2006/time#Instant"
    },
    "Opdracht": {
      "@context": {
        "beschrijving": {
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#beschrijving",
          "@type": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
        },
        "dataleverancier": {
          "@container": "@set",
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#dataleverancier",
          "@type": "@id"
        },
        "identificator": {
          "@container": "@set",
          "@id": "http://www.w3.org/ns/adms#identifier",
          "@type": "@id"
        },
        "ligging": {
          "@container": "@set",
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#ligging",
          "@type": "@id"
        },
        "opdrachtgever": {
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#opdrachtgever",
          "@type": "@id"
        },
        "opdrachtnemer": {
          "@container": "@set",
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#opdrachtnemer",
          "@type": "@id"
        },
        "referentie": {
          "@container": "@set",
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#referentie",
          "@type": "http://www.w3.org/2001/XMLSchema#anyURI"
        },
        "resultaat": {
          "@container": "@set",
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#resultaat",
          "@type": "@id"
        },
        "tijdstip": {
          "@container": "@set",
          "@id": "https://implementatie.data.vlaanderen.be/ns/opdrachten#tijdstip",
          "@type": "@id"
        },
        "type": {
          "@container": "@set",
          "@id": "http://purl.org/dc/terms/type",
          "@type": "@id"
        }
      },
      "@id": "https://data.vlaanderen.be/ns/bodem-en-ondergrond#Opdracht"
    },
    "OpdrachtType": "http://www.w3.org/2004/02/skos/core#Concept",
    "Periode": {
      "@context": {
        "tot": {
          "@id": "http://www.w3.org/2006/time#hasEnd",
          "@type": "@id"
        },
        "van": {
          "@id": "http://www.w3.org/2006/time#hasBeginning",
          "@type": "@id"
        }
      },
      "@id": "http://www.w3.org/2006/time#ProperInterval"
    },
    "TemporeleEntiteit": "http://www.w3.org/2006/time#TemporalEntity"
  }
}
